{
  "name": "frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "vite serve",
    "build": "vite build",
    "clean": "rm -rf ../../dist/frontend ./node_modules/.vite ./reports",
    "lint": "tsc && eslint ./vite.config.ts ./src ../shared --ext .ts",
    "lint:fix": "eslint ./vite.config.ts ./src ../shared --ext .ts --fix",
    "lint:ci": "eslint -f checkstyle -o reports/checkstyle.xml ./vite.config.ts ./src ../shared --ext .ts "
  },
  "dependencies": {
    "bootstrap": "5.3.8",
    "@linkurious/rest-client": "4.3.4",
    "superagent": "10.2.3"
  },
  "devDependencies": {
    "@types/bootstrap": "5.2.10",
    "vite": "8.0.8"
  }
}
